INGEST_TOKEN=replace-with-at-least-24-random-characters
DEEPSEEK_API_KEY=
DRY_RUN=true
ADAPTER=mock
# 旧版微信只读接收时使用：wechat-database；发送仍会安全拒绝，直到另行验证。
WECHAT_STORAGE_PATH=
WECHAT_DB_KEY_FILE=
TEST_SCOPES=[["private","test-user"],["group","test-group"]]
DB_PATH=./data/fishbot.sqlite
PORT=8765
AI_TIMEOUT_MS=30000
AI_RETRIES=2
AI_INTERVAL_MS=500
# 聊天生图；当前精确指纹已验证普通照片缓存解码及引用下载，其他版本仍需验证。
IMAGE_PROVIDER=primary
IMAGE_API_KEY=
IMAGE_BASE_URL=https://tp.xtokenmirror.com/v1
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_BACKUP_KEY=
IMAGE_BACKUP_URL=https://api.zyuou.com/v1
IMAGE_BACKUP_MODEL=gpt-image-2.5-sunburst
# 一次图片请求（含下载）的超时，毫秒，1000..600000。
IMAGE_TIMEOUT_MS=180000
# 可选：已核实的图片 CDN HTTPS origin，逗号分隔，无末尾斜杠。
IMAGE_DOWNLOAD_ORIGINS=
# 原生图片发送仅在当前 DLL 及本机接入验收后开启；新部署默认关闭。
WECHAT_NATIVE_IMAGES=false
FISHBOT_CLOUD_ALL=false
FISHBOT_WINDOWLESS=false
# 实验/验收脚本的明确测试对象；留空拒绝真实好友/群探针，不影响全量生产会话目录。
FISHBOT_TEST_FRIEND_ID=
FISHBOT_TEST_GROUP_ID=
FISHBOT_TEST_GROUP_2_ID=

# 云端需要代理时启用；MCS 的 start-server 会把这些变量传给子进程。
# HTTPS_PROXY=http://127.0.0.1:7890
# NODE_USE_ENV_PROXY=1
# NO_PROXY=localhost,127.0.0.1,api.deepseek.com
# 终端默认显示脱敏消息正文；设false只显示活动状态。文件日志同样受此控制。
TERMINAL_MESSAGE_CONTENT=true
